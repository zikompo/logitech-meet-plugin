<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Loupedeck.GoogleMeetPlugin</RootNamespace>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <PluginApiDir Condition="$(OS) == 'Windows_NT'">C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <PluginApiDir Condition="$(OS) != 'Windows_NT'">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>

    <PluginDir Condition="$(OS) == 'Windows_NT'">$(LocalAppData)\Logi\LogiPluginService\Plugins\</PluginDir>
    <PluginDir Condition="$(OS) != 'Windows_NT'">$(HOME)/Library/Application Support/Logi/LogiPluginService/Plugins/</PluginDir>

    <!-- bin/<Configuration>/ holds metadata/ + actionsymbols/; the DLL goes in its bin/ subfolder. -->
    <PluginOutputDir>$(BaseOutputPath)$(Configuration)/</PluginOutputDir>
    <OutputPath>$(PluginOutputDir)bin/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Key images, read at runtime as "Icons.<name>.svg". Generated by tools/make-icons.mjs. -->
    <EmbeddedResource Include="Icons/*.svg" LogicalName="Icons.%(Filename)%(Extension)" />
    <None Remove="package/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PackageFiles Include="package/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(PluginOutputDir)%(RecursiveDir)" />
  </Target>

  <!-- The .link file tells Logi Plugin Service to load the plugin from this build folder. -->
  <Target Name="LinkPlugin" AfterTargets="CopyPackage">
    <WriteLinesToFile File="$(PluginDir)$(ProjectName).link" Lines="$(PluginOutputDir)" Overwrite="true" />
    <Exec Condition="$(OS) == 'Windows_NT'" Command="start loupedeck:plugin/GoogleMeet/reload" ContinueOnError="true" />
    <Exec Condition="$(OS) != 'Windows_NT'" Command="open loupedeck:plugin/GoogleMeet/reload" ContinueOnError="true" />
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean">
    <Delete Files="$(PluginDir)$(ProjectName).link" />
    <RemoveDir Directories="$(PluginOutputDir)" />
  </Target>

</Project>

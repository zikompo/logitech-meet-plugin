{
  "name": "google-meet-node",
  "version": "0.1.0",
  "description": "Google Meet controls for Logitech devices (Node.js SDK)",
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "npm run typecheck && tsup",
    "build:pack": "npm run build:prod && npm run pack",
    "build:prod": "npm run typecheck && cross-env NODE_ENV=production tsup",
    "pack": "logitoolkit pack",
    "link": "logitoolkit link",
    "typecheck": "tsc --noEmit",
    "unlink": "logitoolkit unlink",
    "watch": "npm run typecheck && tsup --watch",
    "fake-extension-test": "node ../tools/fake-plugin.mjs"
  },
  "author": "Zikora Collins",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@logitech/plugin-sdk": "0.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@logitech/plugin-toolkit": "0.1.1",
    "@types/node": "^22.18.8",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
